// F&D — schema Prisma (ponto de partida; o colega valida tipos/índices/normalização)
// Modelo alinhado com o rascunho do FD §4 e com as estruturas em memória
// (server/src/rooms.js). Tabelas em snake_case; client em camelCase via @map.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (Supavisor, 6543) — runtime
  directUrl = env("DIRECT_URL")   // direta (5432) — migrations
}

enum RoomStatus {
  lobby
  playing
  ended
}

enum Intensity {
  leve
  picante
  hardcore
  caos
}

enum RoundStatus {
  pending
  resolved
  refused
}

enum LifeEventType {
  vida_perdida
  shot
}

enum BoardItemCategory {
  evento // casa ?? (efeito tipado)
  prisao // consequência de prisão (efeitos combinados)
  carta  // catálogo de cartas jogáveis
  regra  // Roleta de Regras (title = regra, value = jogadas que dura)
}

model Room {
  id           String     @id @default(uuid()) @db.Uuid
  code         String     @unique
  hostPlayerId String?    @unique @map("host_player_id") @db.Uuid
  status       RoomStatus @default(lobby)
  createdAt    DateTime   @default(now()) @map("created_at")
  endedAt      DateTime?  @map("ended_at")

  host       Player?       @relation("RoomHost", fields: [hostPlayerId], references: [id], onDelete: SetNull)
  players    Player[]      @relation("RoomPlayers")
  messages   ChatMessage[]
  rounds     GameRound[]
  lifeEvents LifeEvent[]

  @@index([code])
  @@map("rooms")
}

model Player {
  id        String   @id @default(uuid()) @db.Uuid
  roomId    String   @map("room_id") @db.Uuid
  name      String
  lives     Int      @default(3)
  isHost    Boolean  @default(false) @map("is_host")
  connected Boolean  @default(true)
  joinedAt  DateTime @default(now()) @map("joined_at")

  room       Room          @relation("RoomPlayers", fields: [roomId], references: [id], onDelete: Cascade)
  hostOf     Room?         @relation("RoomHost")
  messages   ChatMessage[]
  rounds     GameRound[]   @relation("RoundCurrentPlayer")
  lifeEvents LifeEvent[]

  @@unique([roomId, name]) // nome único DENTRO da sala, não globalmente
  @@index([roomId, name])
  @@map("players")
}

model ChatMessage {
  id        String   @id @default(uuid()) @db.Uuid
  roomId    String   @map("room_id") @db.Uuid
  playerId  String   @map("player_id") @db.Uuid
  text      String
  createdAt DateTime @default(now()) @map("created_at")

  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@map("chat_messages")
}

model GameType {
  id     String  @id @default(uuid()) @db.Uuid
  key    String  @unique // "boca_calada" | "desafio" | "intrigas" | "segredos"
  label  String
  active Boolean @default(true)

  prompts Prompt[]
  rounds  GameRound[]

  @@map("game_types")
}

model Prompt {
  id         String    @id @default(uuid()) @db.Uuid
  gameTypeId String    @map("game_type_id") @db.Uuid
  text       String
  intensity  Intensity @default(leve)
  active     Boolean   @default(true)
  buddy      Boolean   @default(false) // dispara a escolha de "buddy" (bebe junto)
  duration   Int?      // se >0: regra que dura N jogadas (aviso persistente no ecrã)
  tag        String?   // pack temático: "aniversario" | "despedida" | "reencontro" (null = serve sempre)

  gameType GameType    @relation(fields: [gameTypeId], references: [id], onDelete: Cascade)
  rounds   GameRound[]

  @@unique([gameTypeId, text]) // permite seed idempotente (upsert)
  @@index([gameTypeId, intensity, active])
  @@index([tag])
  @@map("prompts")
}

model GameRound {
  id              String      @id @default(uuid()) @db.Uuid
  roomId          String      @map("room_id") @db.Uuid
  gameTypeId      String      @map("game_type_id") @db.Uuid
  currentPlayerId String      @map("current_player_id") @db.Uuid
  promptId        String?     @map("prompt_id") @db.Uuid
  status          RoundStatus @default(pending)
  createdAt       DateTime    @default(now()) @map("created_at")

  room          Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  gameType      GameType    @relation(fields: [gameTypeId], references: [id])
  currentPlayer Player      @relation("RoundCurrentPlayer", fields: [currentPlayerId], references: [id])
  prompt        Prompt?     @relation(fields: [promptId], references: [id])
  lifeEvents    LifeEvent[]

  @@index([roomId])
  @@map("game_rounds")
}

// Bancos do Modo Tabuleiro (?? / prisão / cartas) — conteúdo editável na /admin.
// Uma só tabela discriminada por `category`; as colunas usadas variam por banco:
//   evento → effect + value ; prisao → skipTurns/drink/back/loseCard ; carta → effect (=key) ;
//   regra  → title (texto da regra) + value (jogadas que dura).
model BoardItem {
  id        String            @id @default(uuid()) @db.Uuid
  category  BoardItemCategory
  emoji     String            @default("🎲")
  title     String // evento: título · prisao: nota · carta: nome
  desc      String            @default("") @map("description")
  effect    String? // evento: advance|back|drink|card|prison|others_drink · carta: key da mecânica
  value     Int? // evento: magnitude (casas/golos)
  skipTurns Int               @default(0) @map("skip_turns") // prisao
  drink     Int               @default(0) // prisao: golos
  back      Int               @default(0) // prisao: recua casas
  loseCard  Boolean           @default(false) @map("lose_card") // prisao
  weight    Int               @default(1) // peso na escolha aleatória
  active    Boolean           @default(true)
  createdAt DateTime          @default(now()) @map("created_at")

  @@unique([category, title]) // permite seed idempotente (upsert)
  @@index([category, active])
  @@map("board_items")
}

model LifeEvent {
  id        String        @id @default(uuid()) @db.Uuid
  roomId    String        @map("room_id") @db.Uuid
  playerId  String        @map("player_id") @db.Uuid
  roundId   String        @map("round_id") @db.Uuid
  type      LifeEventType
  createdAt DateTime      @default(now()) @map("created_at")

  room   Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  player Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  round  GameRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@map("life_events")
}
