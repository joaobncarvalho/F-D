# Porta do servidor realtime
PORT=3001

# Origem permitida para CORS (frontend Vite em dev)
CLIENT_ORIGIN=http://localhost:5173

# --- Base de dados (Supabase / Postgres) ---
# Copia as strings exatas do dashboard Supabase → Connect → Prisma/ORMs.
# DATABASE_URL: ligação pooled (Supavisor, porta 6543) — usada em runtime.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: ligação direta (porta 5432) — usada pelo Prisma nas migrations.
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Página de admin (/admin) ---
# Password de acesso ao CRUD de conteúdo. SEM isto definido, a API de admin
# devolve 503 (fica bloqueada). Usa uma password forte no deploy (Railway).
ADMIN_PASSWORD="define-uma-password-forte"

# --- Observabilidade ---
# Nível de log: error | warn | info | debug (default: info).
LOG_LEVEL=info

# Bots de PLAYTEST (dev): põe 1 para permitir o botão "🤖 +bot" no lobby (testar
# sozinho, sem juntar telemóveis). NUNCA definir em produção. Default: desligado.
# ENABLE_DEV_BOTS=1

# Tempo (ms) que uma sala VAZIA sobrevive antes de ser apagada (default: 120000).
# EMPTY_ROOM_GRACE_MS=120000
